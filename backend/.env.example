# Salin ke backend/.env lalu sesuaikan. deploy.sh membuat file ini otomatis.

PORT=3000
# 127.0.0.1 = panel hanya bisa diakses lewat Nginx (disarankan, pakai domain + HTTPS).
# 0.0.0.0   = panel terbuka langsung di http://IP:3000 (tidak terenkripsi).
HOST=127.0.0.1

# Wajib: rahasia penandatangan token login. Buat dengan: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=24h

NGINX_CONF_DIR=/etc/nginx/panel-conf.d
MODSEC_AUDIT_LOG=/var/log/modsec_audit.log

# Email untuk notifikasi kedaluwarsa sertifikat Let's Encrypt (opsional, disarankan)
CERTBOT_EMAIL=

# Rate limit per IP per 15 menit
API_RATE_LIMIT=1000
LOGIN_RATE_LIMIT=10
